# Copy to .env and change DB_PASSWORD.
TZ=America/Sao_Paulo

# Where uploaded photos/videos are stored. Point this at a big disk.
UPLOAD_LOCATION=./library
# Postgres data. Must be on a local disk (not a network share).
DB_DATA_LOCATION=./postgres

# Pin to a specific release (e.g. v2.0.0) if you don't want surprise upgrades.
IMMICH_VERSION=release

# Only A-Za-z0-9 are allowed in the password.
DB_PASSWORD=changeme
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
