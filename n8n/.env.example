# Copy to .env and change N8N_ENCRYPTION_KEY and DB_PASSWORD.
TZ=America/Sao_Paulo

# Pin to a specific release (e.g. 1.60.0) if you don't want surprise upgrades.
N8N_VERSION=latest

# Where n8n stores its config, encryption key backup, and local file storage.
N8N_DATA_LOCATION=./data
# Postgres data. Must be on a local disk (not a network share).
DB_DATA_LOCATION=./postgres

# Required: encrypts stored credentials. Generate with: openssl rand -hex 32
# Losing this key makes existing stored credentials unrecoverable.
N8N_ENCRYPTION_KEY=changeme

DB_PASSWORD=changeme
DB_USERNAME=n8n
DB_DATABASE_NAME=n8n

# Hostname/IP n8n is reachable at (used for webhook URLs and OAuth callbacks).
N8N_HOST=localhost
N8N_PROTOCOL=http
# Full external URL for webhooks, e.g. https://n8n.example.com/. Leave blank for local use.
WEBHOOK_URL=
